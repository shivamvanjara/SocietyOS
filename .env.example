NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://societyos:societyos@localhost:5432/societyos?schema=public
# Prisma migrations use the direct Neon URL; locally, point it at the same database.
DIRECT_URL=postgresql://societyos:societyos@localhost:5432/societyos?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional in development; production requires a separate base64url-encoded 32-byte key.
MFA_ENCRYPTION_KEY=
# Optional credentials for one SocietyOS Razorpay merchant account. All standard
# society subscription billing uses these platform credentials. Residents pay
# society invoices using each society's own credentials configured by its admin.
# Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Legacy invoice-webhook secret; new society invoice webhooks use each society's secret.
RAZORPAY_WEBHOOK_SECRET=
# Required only in production; local development derives a key from SESSION_SECRET.
RAZORPAY_ACCOUNT_ENCRYPTION_KEY=
# Configure the Razorpay webhook for /api/v1/subscriptions/webhooks/razorpay with these events:
# subscription.activated, subscription.charged, subscription.pending, subscription.halted,
# subscription.cancelled, subscription.completed.
RAZORPAY_SUBSCRIPTION_WEBHOOK_SECRET=
# Optional in development; verification and password reset links are shown in the UI.
# Required in production (Resend API).
EMAIL_API_KEY=
EMAIL_FROM=SocietyOS <no-reply@example.com>
# Optional one-time setup values; remove them after running db:bootstrap-admin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-unique-password-here
