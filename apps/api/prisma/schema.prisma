model SubscriptionPlan {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String                @db.VarChar(100)
  description        String?               @db.VarChar(1000)
  billingInterval    BillingInterval       @map("billing_interval")
  pricePaise         BigInt                @map("price_paise") @db.BigInt
  maxBuildings       Int?                  @map("max_buildings")
  maxFlats           Int?                  @map("max_flats")
  razorpayPlanId     String?               @unique @map("razorpay_plan_id") @db.VarChar(100)
  providerPricePaise BigInt?               @map("provider_price_paise") @db.BigInt
  providerInterval   BillingInterval?      @map("provider_interval")
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions      SocietySubscription[]

  @@unique([name, billingInterval])
  @@index([active, billingInterval])
  @@map("subscription_plans")
}

model SocietySubscription {
  id                     String                      @id @default(uuid()) @db.Uuid
  societyId              String                      @map("society_id") @db.Uuid
  planId                 String                      @map("plan_id") @db.Uuid
  createdById            String                      @map("created_by_id") @db.Uuid
  status                 SubscriptionStatus          @default(ACTIVE)
  billingInterval        BillingInterval             @map("billing_interval")
  pricePaise             BigInt                      @map("price_paise") @db.BigInt
  maxBuildings           Int?                        @map("max_buildings")
  maxFlats               Int?                        @map("max_flats")
  providerSubscriptionId String?                     @unique @map("provider_subscription_id") @db.VarChar(100)
  providerPlanId         String?                     @map("provider_plan_id") @db.VarChar(100)
  checkoutUrl            String?                     @map("checkout_url") @db.VarChar(1000)
  cancelAtCycleEnd       Boolean                     @default(false) @map("cancel_at_cycle_end")
  startsAt               DateTime                    @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt                 DateTime?                   @map("ends_at") @db.Timestamptz(6)
  canceledAt             DateTime?                   @map("canceled_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  society                Society                     @relation(fields: [societyId], references: [id], onDelete: Restrict)
  plan                   SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy              User                        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  charges                SocietySubscriptionCharge[]

  @@index([societyId, createdAt])
  @@index([status, endsAt])
  @@map("society_subscriptions")
}

model SocietySubscriptionCharge {
  id                    String              @id @default(uuid()) @db.Uuid
  societySubscriptionId String              @map("society_subscription_id") @db.Uuid
  providerPaymentId     String              @unique @map("provider_payment_id") @db.VarChar(100)
  providerEventId       String              @map("provider_event_id") @db.VarChar(120)
  amountPaise           BigInt              @map("amount_paise") @db.BigInt
  currency              String              @default("INR") @db.VarChar(3)
  status                String              @db.VarChar(20)
  paidAt                DateTime?           @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  subscription          SocietySubscription @relation(fields: [societySubscriptionId], references: [id], onDelete: Restrict)

  @@index([societySubscriptionId, createdAt])
  @@map("society_subscription_charges")
}

model SocietySubscriptionWebhookEvent {
  providerEventId       String    @id @map("provider_event_id") @db.VarChar(120)
  societySubscriptionId String?   @map("society_subscription_id") @db.Uuid
  eventType             String    @map("event_type") @db.VarChar(80)
  processedAt           DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([societySubscriptionId, createdAt])
  @@map("society_subscription_webhook_events")
}

