  invitedBy   User        @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([societyId, id])
  @@index([societyId, email, acceptedAt])
  @@index([societyId, expiresAt])
  @@map("society_invitations")
}

model Session {
